{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "barryvdh/laravel-dompdf": "^3.0",
        "google/apiclient": "^2.15",
        "google/apiclient-services": "^0.407.0",
        "google/auth": "^1.47",
        "intervention/image": "^2.7",
        "kreait/firebase-php": "^7.24",
        "laravel/framework": "^12.0",
        "laravel/reverb": "^1.6",
        "laravel/sanctum": "^4.2",
        "laravel/tinker": "^2.10.1",
        "maatwebsite/excel": "^3.1",
        "microsoft/microsoft-graph": "^2.0",
        "phpoffice/phpspreadsheet": "^1.30.0",
        "rcv/core": "dev-main",
        "spatie/laravel-activitylog": "^4.10",
        "square/square": "^43.2",
        "stripe/stripe-php": "^20.0",
        "twilio/sdk": "^8.11"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pail": "^1.2.2",
        "laravel/pint": "^1.13",
        "laravel/sail": "^1.41",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^11.5.3"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/",
            "Modules\\Core\\": "Modules/Core/src/",
            "Modules\\Acl\\": "Modules/Acl/src/",
            "Modules\\Activitylog\\": "Modules/Activitylog/src/",
            "Modules\\Admin\\": "Modules/Admin/src/",
            "Modules\\Backend\\": "Modules/Backend/src/",
            "Modules\\Cart\\": "Modules/Cart/src/",
            "Modules\\Checkout\\": "Modules/Checkout/src/",
            "Modules\\Cms\\": "Modules/Cms/src/",
            "Modules\\Countries\\": "Modules/Countries/src/",
            "Modules\\Currencies\\": "Modules/Currencies/src/",
            "Modules\\DataView\\": "Modules/DataView/src/",
            "Modules\\Discounts\\": "Modules/Discounts/src/",
            "Modules\\EmailNotification\\": "Modules/EmailNotification/src/",
            "Modules\\Filemanager\\": "Modules/Filemanager/src/",
            "Modules\\FoodManagements\\": "Modules/FoodManagements/src/",
            "Modules\\GeneralSetting\\": "Modules/GeneralSetting/src/",
            "Modules\\KYC\\": "Modules/KYC/src/",
            "Modules\\MobileConfiguration\\": "Modules/MobileConfiguration/src/",
            "Modules\\Notifications\\": "Modules/Notifications/src/",
            "Modules\\Orders\\": "Modules/Orders/src/",
            "Modules\\Payments\\": "Modules/Payments/src/",
            "Modules\\Reports\\": "Modules/Reports/src/",
            "Modules\\Restaurant\\": "Modules/Restaurant/src/",
            "Modules\\Stripe\\": "Modules/Stripe/src/",
            "Modules\\Tax\\": "Modules/Tax/src/",
            "Modules\\Twilio\\": "Modules/Twilio/src/",
            "Modules\\WebPushNotification\\": "Modules/WebPushNotification/src/",
            "Modules\\Website\\": "Modules/Website/src/"
        },
        "files": []
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "tbachert/spi": true
        },
        "platform": {
            "php": "8.2.35"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
