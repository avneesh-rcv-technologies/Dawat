{
  "version": 1,
  "name": "Food item serving options",
  "scope": "One configuration applied independently to each serving_options row.",
  "default_serve_type": "tray",
  "collection": {
    "field": "serving_options",
    "validation": [
      "required",
      "array",
      "min:1",
      "max:50"
    ],
    "item_validation": [
      "required",
      "array:id,serve_type,serving_name,quantity,unit,serves,price,discount_price,is_available,min_guests,max_guests"
    ],
    "id": {
      "input": "hidden",
      "validation": [
        "nullable",
        "integer",
        "distinct"
      ],
      "ownership": "Existing option ID must belong to the food item being edited."
    },
    "min_items": 1,
    "max_items": 50
  },
  "resolution": {
    "validation_format": "Laravel validation rules. Wildcards refer to the same serving option row.",
    "enabled_fields": "Show and enable only the fields listed for the selected serve type.",
    "disabled_fields": "Hide, disable, and exclude these fields from validation and submission.",
    "validation": "Use fields[field].validation and replace it with serve_types[type].validation_overrides[field] when present. Never validate disabled fields.",
    "required_fields": "Apply required only to the fields listed for the selected serve type.",
    "labels": "Use type-specific field_labels when present, otherwise fields[field].label.",
    "unit_changes": "Only allow units listed for the selected serve type; apply unit_fields[unit] to quantity.",
    "cross_field_validation": "Revalidate discount_price when price changes and max_guests when min_guests changes."
  },
  "on_change": {
    "serve_type": [
      "Resolve configuration for the selected type; reject unknown types.",
      "Update visible, enabled, and required fields for this row.",
      "Remove validation errors for disabled fields.",
      "Replace unit options with allowed_units.",
      "Keep the current unit if allowed; otherwise select defaults.unit.",
      "Apply type-specific field labels and validation overrides.",
      "Apply unit-specific quantity settings when quantity is enabled.",
      "Revalidate enabled fields and refresh the price summary."
    ],
    "unit": [
      "Reject units not allowed by the selected serve type.",
      "Update quantity label, step, and validation from unit_fields.",
      "Revalidate quantity without converting or replacing its entered value."
    ],
    "price": [
      "Revalidate discount_price and refresh the price summary."
    ],
    "discount_price": [
      "Refresh the price summary."
    ],
    "min_guests": [
      "Revalidate max_guests."
    ]
  },
  "fields": {
    "serve_type": {
      "label": "Serve type",
      "input": "select",
      "validation": [
        "required",
        "in:tray,plate,bowl,box,portion,piece,by_weight,by_volume,per_person,package"
      ],
      "help": "Choose how this option is sold. Use the serving name for sizes such as Half tray or Family box."
    },
    "serving_name": {
      "label": "Serving name",
      "input": "text",
      "validation": [
        "required",
        "string",
        "max:100"
      ],
      "help": "Name customers will see, e.g. Half tray, Large bowl, or Family box.",
      "placeholder": "e.g. Standard"
    },
    "quantity": {
      "label": "Size (quantity)",
      "input": "number",
      "step": 0.01,
      "min": 0.01,
      "max": 99999999.99,
      "validation": [
        "required",
        "numeric",
        "decimal:0,2",
        "gt:0",
        "max:99999999.99"
      ],
      "help": "Amount included in one option. Example: 15 with Pieces means 15 pieces."
    },
    "unit": {
      "label": "Unit",
      "input": "select",
      "validation": [
        "required",
        "string",
        "max:30"
      ],
      "options_source": "serve_types.{serve_type}.allowed_units",
      "help": "Choose a unit matching this serving option."
    },
    "serves": {
      "label": "Number of serves",
      "input": "number",
      "step": 1,
      "min": 1,
      "max": 4294967295,
      "validation": [
        "required",
        "integer",
        "min:1",
        "max:4294967295"
      ],
      "help": "Number of people one purchased option feeds. Enter 1 for an individual serving."
    },
    "min_guests": {
      "label": "Minimum guests",
      "input": "number",
      "step": 1,
      "min": 1,
      "max": 4294967295,
      "validation": [
        "required",
        "integer",
        "min:1",
        "max:4294967295"
      ],
      "help": "Smallest guest count accepted for this option, e.g. 10 people."
    },
    "max_guests": {
      "label": "Maximum guests",
      "input": "number",
      "step": 1,
      "min": 1,
      "max": 4294967295,
      "validation": [
        "nullable",
        "integer",
        "gte:serving_options.*.min_guests",
        "max:4294967295"
      ],
      "help": "Largest guest count accepted. Leave empty for no limit; must be at least the minimum."
    },
    "price": {
      "label": "Price for this size",
      "input": "number",
      "step": 0.01,
      "min": 0,
      "max": 99999999.99,
      "validation": [
        "required",
        "numeric",
        "decimal:0,2",
        "min:0",
        "max:99999999.99"
      ],
      "help": "Total price for this size before tax. Tax is added using the item tax percentage.",
      "placeholder": "0.00"
    },
    "discount_price": {
      "label": "Discount price",
      "input": "number",
      "step": 0.01,
      "min": 0,
      "validation": [
        "nullable",
        "numeric",
        "decimal:0,2",
        "min:0",
        "lt:serving_options.*.price"
      ],
      "help": "Optional reduced price before tax, not the amount off. Must be lower than price; leave blank for no discount.",
      "placeholder": "0.00"
    },
    "is_available": {
      "label": "Available",
      "input": "checkbox",
      "default": true,
      "validation": [
        "required",
        "boolean"
      ],
      "help": "Uncheck to temporarily stop offering this option while keeping its details."
    }
  },
  "serve_types": {
    "tray": {
      "label": "Tray",
      "enabled_fields": [
        "serve_type",
        "serving_name",
        "price",
        "discount_price",
        "is_available",
        "quantity",
        "unit",
