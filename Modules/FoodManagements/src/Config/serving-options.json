        "max_guests"
      ],
      "allowed_units": [
        "Trays",
        "Pieces"
      ],
      "defaults": {
        "unit": "Trays"
      },
      "field_labels": {
        "serving_name": "Serving name",
        "price": "Price for this size"
      },
      "validation_overrides": {
        "unit": [
          "required",
          "string",
          "max:30",
          "in:Trays,Pieces"
        ]
      },
      "pricing_basis": "per_option",
      "help": "Tray: set the amount included in one option and its total price before tax. Add another option for a different size.",
      "field_help": {}
